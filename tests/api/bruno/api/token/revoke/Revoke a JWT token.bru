meta {
  name: Revoke a JWT token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/token/revoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "token": "",
    "jti": ""
  }
}

docs {
  Revokes a JWT token by its jti (or full token value) so it can no
  longer be used to authenticate. Requires a valid bearer token.
  The revocation takes effect in memory immediately and is persisted
  when a revocation store is available; a persistence failure is
  reported as a 500 while the in-memory revocation still applies.
  
}

example {
  name: 200 Response
  description: Token revoked successfully
  
  request: {
    url: {{baseUrl}}/api/token/revoke
    method: POST
    mode: json
    body:json: {
      {
        "token": "",
        "jti": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "revoked",
          "jti": "9f2c4e8a1b3d5c7e9a0b1c2d3e4f5a6b"
        }
      '''
    }
  }
}

