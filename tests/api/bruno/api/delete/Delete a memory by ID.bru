meta {
  name: Delete a memory by ID
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/delete
  body: none
  auth: bearer
}

params:query {
  @description('Unique memory identifier.')
  id: e114ff39-fd89-4efc-8955-2ce5bc67c896
}

auth:bearer {
  token: {{token}}
}

docs {
  Permanently removes a stored memory. Also accepts POST for clients that cannot send DELETE.
}

example {
  name: 200 Response
  description: Memory deleted
  
  request: {
    url: {{baseUrl}}/api/delete
    method: DELETE
    mode: none
    params:query: {
      id: e114ff39-fd89-4efc-8955-2ce5bc67c896
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "deleted": true
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Bad request - missing id parameter
  
  request: {
    url: {{baseUrl}}/api/delete
    method: DELETE
    mode: none
    params:query: {
      id: e114ff39-fd89-4efc-8955-2ce5bc67c896
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "not found"
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized
  
  request: {
    url: {{baseUrl}}/api/delete
    method: DELETE
    mode: none
    params:query: {
      id: e114ff39-fd89-4efc-8955-2ce5bc67c896
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 404 Response
  description: Memory not found
  
  request: {
    url: {{baseUrl}}/api/delete
    method: DELETE
    mode: none
    params:query: {
      id: e114ff39-fd89-4efc-8955-2ce5bc67c896
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "not found"
        }
      '''
    }
  }
}
