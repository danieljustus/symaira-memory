meta {
  name: Semantic vector similarity search
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/search
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "query": "User active project",
    "scope": "project",
    "limit": 3
  }
}

docs {
  Queries stored memories using cosine similarity over local text embeddings.
}

example {
  name: 200 Response
  description: Search completed successfully
  
  request: {
    url: {{baseUrl}}/api/search
    method: POST
    mode: json
    body:json: {
      {
        "query": "User active project",
        "scope": "project",
        "limit": 3
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": "e114ff39-fd89-4efc-8955-2ce5bc67c896",
            "content": "User prefers typescript over python",
            "scope": "global",
            "metadata": {
              "source": "extension",
              "similarity_score": "0.8924"
            },
            "embedding": [],
            "created_at": "2026-06-02T16:20:23Z",
            "updated_at": "2026-06-02T16:20:23Z"
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - missing or invalid JWT token
  
  request: {
    url: {{baseUrl}}/api/search
    method: POST
    mode: json
    body:json: {
      {
        "query": "User active project",
        "scope": "project",
        "limit": 3
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
