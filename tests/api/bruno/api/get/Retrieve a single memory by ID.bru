meta {
  name: Retrieve a single memory by ID
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/get
  body: none
  auth: bearer
}

params:query {
  @description('Unique memory identifier.')
  id: e114ff39-fd89-4efc-8955-2ce5bc67c896
}

auth:bearer {
  token: {{token}}
}

docs {
  Returns the full memory object for the given UUID.
}

example {
  name: 200 Response
  description: Memory found
  
  request: {
    url: {{baseUrl}}/api/get
    method: GET
    mode: none
    params:query: {
      id: e114ff39-fd89-4efc-8955-2ce5bc67c896
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "e114ff39-fd89-4efc-8955-2ce5bc67c896",
          "content": "User prefers typescript over python",
          "scope": "global",
          "metadata": {
            "source": "extension",
            "similarity_score": "0.8924"
          },
          "embedding": [],
          "created_at": "2026-06-02T16:20:23Z",
          "updated_at": "2026-06-02T16:20:23Z"
        }
      '''
    }
  }
}

